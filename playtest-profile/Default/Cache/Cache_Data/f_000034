  grove_warden: {
    id: "grove_warden",
    nodes: [
      {
        id: "start",
        text: "Don't mind the bandages. I earned them the hard way. Name's **Callum**. Ranger, or what's left of one. I went into that grove to the west thinking I'd thin the growth. The growth thinned me instead.",
        responses: [
